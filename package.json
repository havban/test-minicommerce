{
  "name": "future2021",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "bun --bun vite",
    "dev": "bun --bun vite",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview --port 8080 --strictPort",
    "start": "bun --bun vite preview --port 8080 --strictPort",
    "lint": "bun --bun eslint .",
    "test:unit": "bun --bun vitest run",
    "test": "bun --bun playwright test",
    "test:integration": "bun --bun playwright test",
    "test:update-snapshots": "bun --bun playwright test --update-snapshots"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "register-service-worker": "^1.7.2",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.3",
    "sass": "^1.105.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
